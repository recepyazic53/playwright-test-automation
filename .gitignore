node_modules/
.env

# Playwright çıktıları ve oturum dosyaları
playwright-report/
test-results/
playwright/.auth/

# Playwright tarayıcı ikilileri ve npm önbelleği — büyük ve makineye özeldir.
.playwright-browsers/
.npm-cache/

# Yerel test sunucusunun log dosyası — makineye özeldir.
scripts/test-sunucu.log

# Nöbetçi veritabanı (projeler, profiller, senaryolar, koşular — hassas alanlar şifreli) ve yerel yedekleri:
# YALNIZCA bu makinede durur, Git'e/buluta ASLA gitmez.
veri/
*.tayedek
# Birim testlerinin eski biçim (1) yedek fixture'ı (test parolasıyla, gerçek veri içermez)
!tests/birim/fixtures/*.tayedek

# Taşınabilir paket çıktısı (npm run paketle)
dist/
