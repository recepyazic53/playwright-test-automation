{
  "name": "playwright-test-automation",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:canli": "cross-env TEST_ENV=canli playwright test",
    "test:test-ortami": "cross-env TEST_ENV=test playwright test",
    "typecheck": "tsc --noEmit",
    "test:birim": "playwright test --config playwright.birim.config.ts",
    "test-sunucu": "node scripts/test-sunucu.mjs",
    "baslat": "node scripts/baslat.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/node": "^24.13.6",
    "cross-env": "^10.1.0",
    "dotenv": "^16.6.1",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "sql.js": "1.14.2"
  }
}
