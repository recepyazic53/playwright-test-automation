{
  "name": "playwright-test-automation",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:canli": "cross-env TEST_ENV=canli playwright test",
    "test:test-ortami": "cross-env TEST_ENV=test playwright test",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "test:birim": "playwright test --config playwright.birim.config.ts",
    "allure:generate:test": "allure generate ./allure-results-test --clean -o ./allure-report-test && node scripts/allure-history-sync.mjs test",
    "allure:generate:canli": "allure generate ./allure-results-canli --clean -o ./allure-report-canli && node scripts/allure-history-sync.mjs canli",
    "allure:open:test": "allure open ./allure-report-test",
    "allure:open:canli": "allure open ./allure-report-canli",
    "allure:report:test": "npm run allure:generate:test && npm run allure:open:test",
    "allure:report:canli": "npm run allure:generate:canli && npm run allure:open:canli",
    "allure:generate": "npm run allure:generate:test",
    "allure:open": "npm run allure:open:test",
    "allure:report": "npm run allure:report:test",
    "hata:ozet:test": "node scripts/urun-hata-raporu.mjs test",
    "hata:ozet:canli": "node scripts/urun-hata-raporu.mjs canli",
    "rapor:test": "npm run allure:generate:test && node scripts/urun-hata-raporu.mjs test && node scripts/dosya-ac.mjs dashboard-test.html && npm run allure:open:test",
    "rapor:canli": "npm run allure:generate:canli && node scripts/urun-hata-raporu.mjs canli && node scripts/dosya-ac.mjs dashboard-canli.html && npm run allure:open:canli",
    "test-sunucu": "node scripts/test-sunucu.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/node": "^24.13.6",
    "allure-commandline": "^2.34.0",
    "allure-js-commons": "^3.4.0",
    "allure-playwright": "^3.4.0",
    "cross-env": "^10.1.0",
    "dotenv": "^16.6.1",
    "typescript": "^5.9.0"
  }
}
