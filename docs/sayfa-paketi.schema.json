{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nobetci:sayfa-paketi:1",
  "title": "Nöbetçi sayfa paketi (sürüm 1)",
  "description": "Bir sayfanın yalnızca okunarak incelenmesiyle üretilen paket: ekran modeli, senaryo önerileri, gereken ayarlar, bilinmeyenler, isteğe bağlı ekran görüntüleri. Ayrıntılar ve kurallar: docs/sayfa-paketi.md. Model içeriği ortak model doğrulayıcısıyla (scripts/dogrulama/ekran-modeli-dogrulayici.mjs) denetlenir; bu şema yalnızca paket zarfını tanımlar. GİZLİ/KİŞİSEL veri içeren paket reddedilir.",
  "type": "object",
  "additionalProperties": false,
  "required": ["tur", "surum", "meta", "model", "senaryoOnerileri", "gerekenAyarlar", "bilinmeyenler"],
  "properties": {
    "$schema": { "type": "string" },
    "tur": { "const": "sayfa-paketi" },
    "surum": { "const": 1 },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ekran", "olusturan", "olusturulma", "baglamProfilleri"],
      "properties": {
        "proje": { "type": "string", "description": "Bilgi amaçlı proje adı." },
        "ekran": {
          "type": "object",
          "additionalProperties": false,
          "required": ["anahtar", "ad", "urlYolu"],
          "properties": {
            "anahtar": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$", "description": "Ekranın kalıcı anahtarı; model.id ile aynı olmalı." },
            "ad": { "type": "string", "minLength": 1, "maxLength": 120 },
            "urlYolu": { "type": "string", "pattern": "^/(?!/)", "description": "Tam adres değil YOL; ortam adresi Ayarlar'dan gelir." }
          }
        },
        "olusturan": { "type": "string", "minLength": 1 },
        "olusturulma": { "type": "string", "format": "date-time" },
        "baglamProfilleri": { "type": "array", "items": { "type": "string" }, "description": "İncelemede kullanılan bağlam profillerinin ADLARI (değer yok)." },
        "not": { "type": "string" }
      }
    },
    "model": {
      "type": "object",
      "description": "Ekran modeli (tests/support/ekran-modeli.ts > EkranModeli). Kendi kendine yetmeli ya da projede var olan alt modellere başvurmalı. İsteğe bağlı baglamGorunurlugu: { profiller: [ad], alanlar: { alanId: { profil: true | false | null } } }.",
      "required": ["semaSurumu", "tur", "id", "ad", "aciklama", "ekranUrl", "specDosyasi", "pageObject", "veriKaynaklari", "kosullar", "adimlar", "senaryoDuzeyi", "urunDuzeyi", "isKurallari", "bilinmeyenler"],
      "properties": {
        "semaSurumu": { "enum": [1, 2], "description": "2: adımlarda koşu tanımı (kosu: aksiyonlar, basariGostergesi, hataGostergesi, zamanAsimiSn) — model koşucusu." },
        "tur": { "const": "ekran" },
        "baglam": {
          "type": "object",
          "description": "Bağlam profili ekranı: { aciklama, veriKaynagi, alanlar, bilinenProfiller, pageObject? }. Önceki sürümün eski adı hâlâ okunur (scripts/dogrulama/eski-anahtarlar.mjs; yeni kayıtta baglam yazılır); ikisi birlikte olamaz. Alt model alanında kayıt adı eslesme.kayitAlani (eski adı da okunur)."
        },
        "baglamGorunurlugu": {
          "type": "object",
          "additionalProperties": false,
          "required": ["profiller", "alanlar"],
          "properties": {
            "profiller": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
            "alanlar": { "type": "object", "additionalProperties": { "type": "object", "additionalProperties": { "type": ["boolean", "null"] } } },
            "kaynak": { "type": "string" },
            "not": { "type": "string" }
          }
        }
      }
    },
    "senaryoOnerileri": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["baslik", "veri", "beklenenSonuc", "gerekce"],
        "properties": {
          "baslik": { "type": "string", "minLength": 1, "maxLength": 300 },
          "veri": { "type": "object", "description": "Modelin senaryo biçimi (alan.eslesme.senaryo anahtarları). Kişi / kayıt verisi değer olarak yazılmaz: ${Tablo.Sütun} ya da ${Tablo[etiket].Sütun} tablo başvurusu (kimlik bloğunda kayıt adı)." },
          "adimKapsami": { "type": "array", "items": { "type": "string" }, "description": "Dahil edilen isteğe bağlı adımların kimlikleri." },
          "beklenenSonuc": {
            "type": "object",
            "required": ["tur", "aciklama"],
            "properties": { "tur": { "enum": ["basari", "hata"] }, "aciklama": { "type": "string" } }
          },
          "gerekce": { "type": "string", "minLength": 1 }
        }
      }
    },
    "gerekenAyarlar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["girisGerekli", "ikiAsamaliDogrulama", "captchaGoruldu", "testVerisiTurleri"],
      "properties": {
        "girisGerekli": { "type": "boolean" },
        "ikiAsamaliDogrulama": { "enum": ["yok", "totp", "sms", "bilinmiyor"] },
        "captchaGoruldu": { "type": "boolean" },
        "testVerisiTurleri": { "type": "array", "items": { "type": "string" }, "description": "Senaryoların gerektirdiği test verisi TABLOLARININ adları (anahtar adı geriye uyum için korunur)." },
        "baglamTurleri": { "type": "array", "items": { "type": "string" } },
        "not": { "type": "string" }
      }
    },
    "bilinmeyenler": { "type": "array", "items": { "type": "string" } },
    "kanitlar": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ad", "icerikTuru", "veri"],
        "properties": {
          "ad": { "type": "string", "minLength": 1, "maxLength": 120 },
          "aciklama": { "type": "string" },
          "icerikTuru": { "const": "image/png" },
          "veri": { "type": "string", "contentEncoding": "base64", "contentMediaType": "image/png", "description": "En fazla 4 MB (çözülmüş)." }
        }
      }
    },
    "testVerisi": {
      "type": "object",
      "description": "İsteğe bağlı: test verisi tabloları (satır = birlikte geçerli değerler) — ekran listeleri (tur liste; seçim alanlarının seçenekleri, ad \"<Ekran adı> — <Alan>\", bağımlı listelerde kombinasyon) ve kişi / kayıt tabloları (tur kayit; satır = kayıt) — ve alan → sütun bağlantıları. Önizlemede kullanıcı onaylamadan yazılmaz. Gizli sütuna değer yazılmaz.",
      "additionalProperties": false,
      "required": ["tablolar"],
      "properties": {
        "tablolar": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ad", "sutunlar", "satirlar"],
            "properties": {
              "ad": { "type": "string", "pattern": "^[^.\\[\\]{}$<>&|\\u0000-\\u001f]{1,60}$" },
              "tur": { "enum": ["liste", "kayit"], "description": "liste = ekran listesi (seçim alanının seçenekleri); kayit = kişi ve kayıt verisi (satır = kayıt; senaryo ${Tablo.Sütun} ile başvurur)." },
              "aciklama": { "type": "string" },
              "sutunlar": {
                "type": "array",
                "minItems": 1,
                "maxItems": 40,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["ad"],
                  "properties": {
                    "ad": { "type": "string", "pattern": "^[^.\\[\\]{}$<>&|\\u0000-\\u001f]{1,60}$" },
                    "gizli": { "type": "boolean", "description": "Değeri Nöbetçi'de şifreli girilir; pakette hücreleri null." },
                    "karsiliklar": {
                      "type": "object",
                      "description": "Hücre değeri → sayfadaki (seçenek value) / servisteki karşılık.",
                      "additionalProperties": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": { "sayfa": { "type": "string" }, "servis": { "type": "string" } }
                      }
                    }
                  }
                }
              },
              "satirlar": {
                "type": "array",
                "maxItems": 5000,
                "items": { "type": "array", "items": { "type": ["string", "number", "boolean", "null"] } }
              }
            }
          }
        },
        "baglantilar": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["alanId", "tablo", "sutun"],
            "properties": {
              "alanId": { "type": "string", "description": "Modeldeki alan kimliği (senaryoda ayarlanan seçim / metin alanı)." },
              "tablo": { "type": "string" },
              "sutun": { "type": "string" },
              "etiket": { "type": "string", "pattern": "^[\\p{L}\\p{N} _-]{1,40}$" }
            }
          }
        }
      }
    }
  }
}
