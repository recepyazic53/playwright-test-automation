# NOT (Nöbetçi): Test verisi, ortam adresleri ve giriş bilgileri artık YALNIZCA platform
# veritabanındadır (veri/platform.db, şifreli). Aşağıdaki adres/kullanıcı/parola değişkenleri yalnızca
# eski proje dosyalarını TEK SEFERLİK aktarırken okunur (Nöbetçi > "Eski proje dosyalarını aktar";
# eski dosya klasöründe .env varsa o önceliklidir). Testler bu değişkenleri KULLANMAZ.
TEST_ENV=test

# Canlı ve test ortamlarının adresleri (yalnızca aktarım için; örnek değerler)
CANLI_BASE_URL=https://canli.ornek.invalid
TEST_BASE_URL=https://test.ornek.invalid

# Kimlik bilgilerini yalnızca yerel .env dosyanızda tutun; Git'e eklemeyin.
LOGIN_USERNAME=
TEST_PASSWORD=
CANLI_PASSWORD=

# CANLI'daki 2FA (authenticator) kodu. Authenticator uygulamasına QR ile eklerken
# gösterilen base32 "secret/seed" değerini buraya girin — kod her koşu anında bu
# secret'tan taze olarak üretilir, elle güncellemenize gerek kalmaz.
CANLI_AUTH_SECRET=
# CANLI_AUTH_SECRET tanımlı değilse yedek olarak kullanılan, TEK SEFERLİK sabit kod
# (uygulamada o an görünen 6 haneli kodu buraya kopyalayabilirsiniz; ~30 saniye
# içinde kullanılmazsa geçersiz olur).
CANLI_AUTH_CODE=

# Varsayılan Playwright tarayıcı kurulumunu kullanmak için bu satırı boş bırakın.
# PLAYWRIGHT_BROWSERS_PATH=./.playwright-browsers

# Nöbetçi yerel sunucusunun portu ("npm run baslat"). Varsayılan 5566 çakışıyorsa değiştirin.
# TEST_SUNUCU_PORT=5566

# Koşu videolarının saklama süresi (gün). Bu süreden eski videolar şifreli medya
# deposundan (veri/medya/) silinir (Ayarlar > Güvenlik'te kaydedilen değer önceliklidir).
# Ekran görüntüleri ve sonuçlar silinmez. Eski allure-results-*/ klasörlerine dokunulmaz.
# Boş bırakılırsa 30 gün.
# VIDEO_SAKLAMA_GUN=30

# PLATFORM: Terminal koşularında kasa parolası GİZLİ olarak sorulur — önerilen yol budur. Yalnızca
# etkileşimsiz ortamlarda (CI) ve "npx playwright test --list" için parolayı gizli bir ortam değişkeni
# olarak verin; bu dosyaya YAZMAYIN.
# PLATFORM_KASA_PAROLASI=
